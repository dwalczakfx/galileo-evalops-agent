# Galileo EvalOps Agent deployment configuration
#
# Copy this file to .env and fill the REQUIRED values:
#   cp .env.example .env
#
# Never commit .env. It is excluded by .gitignore.

# REQUIRED: Galileo connection and exact default working scope.
GALILEO_API_URL=
GALILEO_CONSOLE_URL=
GALILEO_API_KEY=
GALILEO_PROJECT=
GALILEO_LOG_STREAM=

# REQUIRED: model connection. The defaults use Gemini 2.5 Flash through the
# Galileo Model Router, matching the demo configuration. Keep the key blank in
# source control and supply it only in your private .env or secret manager.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://llm.galileo.ai/v1
EVALOPS_MODEL=gemini-2.5-flash
EVALOPS_MAX_COMPLETION_TOKENS=1600

# REQUIRED: Galileo Agent Control runtime and installation-time policy setup.
# The API key value is GALILEO_API_KEY; this setting is only the HTTP header name.
AGENT_CONTROL_URL=
AGENT_CONTROL_API_KEY_HEADER=Galileo-API-Key
AGENT_CONTROL_RUNTIME_AUTH_MODE=auto
EVALOPS_AGENT_NAME=galileo-evalops-agent

# Dedicated Galileo streams used by this application.
# EVALOPS_LOG_STREAM must differ from GALILEO_LOG_STREAM.
EVALOPS_LOG_STREAM=evalops-agent
EVALOPS_DEMO_STREAM=evalops-demo-source

# Cost and bounded-query limits.
EVALOPS_DEFAULT_LOOKBACK_HOURS=24
EVALOPS_MAX_LOOKBACK_DAYS=7
EVALOPS_MAX_TRACES_PER_QUERY=20
EVALOPS_MAX_TRACE_CANDIDATES=50
EVALOPS_MAX_DETAILED_TRACES=5
EVALOPS_MAX_DATASET_ROWS=20
EVALOPS_MAX_EXPERIMENT_ROWS=20
EVALOPS_MAX_TOOL_CALLS_PER_TURN=8
EVALOPS_MAX_STEERING_RETRIES=2
EVALOPS_MAX_OUTPUT_CHARS=12000
EVALOPS_MAX_MANAGEMENT_STREAMS=10
EVALOPS_MAX_MANAGEMENT_RESOURCES=20
EVALOPS_MAX_SESSION_SAMPLE=5
EVALOPS_MAX_COVERAGE_ROWS=30
EVALOPS_MAX_GENERATION_CALLS=50
EVALOPS_MAX_EVALUATOR_CALLS=100

# OPTIONAL: use another environment file instead of ./.env.
# Prefer the --env-file CLI option for one-off runs.
EVALOPS_ENV_FILE=
